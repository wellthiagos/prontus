<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="prontusTestPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.com.prontus.paciente.infrastructure.persistence.PacienteEntity</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.h2.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:prontus-test;MODE=Oracle;DEFAULT_NULL_ORDERING=HIGH"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="sa"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="sa"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="create-drop"/>

            <property name="hibernate.jdbc.time_zone"
                      value="UTC"/>

            <property name="hibernate.cache.use_second_level_cache"
                      value="false"/>
        </properties>

    </persistence-unit>

</persistence>