<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="prontusPU" transaction-type="JTA">

        <jta-data-source>java:jboss/datasources/ProntusDS</jta-data-source>

        <class>br.com.prontus.paciente.infrastructure.persistence.PacienteEntity</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.hbm2ddl.auto"
                      value="validate"/>
            <property name="hibernate.jdbc.time_zone"
                      value="UTC"/>
        </properties>

    </persistence-unit>

</persistence>